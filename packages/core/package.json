{
  "name": "shanshui",
  "version": "0.1.0",
  "description": "Procedurally generated Chinese ink landscapes (山水) for the web. Seeded, animated, dependency-free SVG, as a JS API or a <shan-shui> web component.",
  "type": "module",
  "main": "./dist/shanshui.cjs",
  "module": "./dist/shanshui.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/shanshui.iife.js",
  "jsdelivr": "./dist/shanshui.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shanshui.js",
      "require": "./dist/shanshui.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./dist/shanshui.iife.js"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.cdn.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barada02/Mordern_Web_Art.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/barada02/Mordern_Web_Art/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/barada02/Mordern_Web_Art/issues"
  },
  "keywords": [
    "shanshui",
    "generative-art",
    "procedural",
    "landscape",
    "ink",
    "svg",
    "chinese-painting",
    "web-component",
    "hero",
    "background"
  ],
  "license": "MIT",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1"
  }
}
